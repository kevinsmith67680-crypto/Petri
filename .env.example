# Copy to .env and fill in. Never commit .env — .gitignore already excludes it.

# ── storage ────────────────────────────────────────────────────────────────
# Supabase / Postgres. Leave unset to run entirely in memory.
#
# IMPORTANT: use the Shared Pooler (Supavisor) in SESSION mode, port 5432.
# Supabase's direct connection (db.<ref>.supabase.co) is IPv6-only and Render
# is IPv4, so a direct string fails with ENETUNREACH.
#
#   Session mode      port 5432  <- correct for this long-running server
#   Transaction mode  port 6543  <- for serverless, do not use here
#
# Dashboard -> Connect -> Session pooler.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Fallback JSON file when DATABASE_URL is unset. Ignored if it is set.
# DATA_FILE=./data/petri.json

# ── server ─────────────────────────────────────────────────────────────────
PORT=8080
BOTS=14
MAX_CONN_PER_IP=3
TRUST_PROXY=1
ALLOWED_ORIGINS=https://your-service.onrender.com

# ── money ──────────────────────────────────────────────────────────────────
# House cut on winnings, basis points. 250 = 2.5%.
RAKE_BPS=0

# Demands a real payment ramp. Startup FAILS unless one is implemented.
# REAL_MONEY=1

# ── test mode ──────────────────────────────────────────────────────────────
# Solo play against bots with demo credits. Lowers LOBBY_MIN to 1, fills the
# arena with 60 bots, and shortens rounds to 2 minutes. Refuses to start
# alongside REAL_MONEY=1.
# TEST_MODE=1

# ── sign in with Google ────────────────────────────────────────────────────
# OAuth client id from the Google Cloud console (Web application type).
# Not a secret. No client secret or redirect URI is needed: this uses the
# ID-token flow. Add your origin to "Authorised JavaScript origins".
# Unset hides the button and loads nothing from Google.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
